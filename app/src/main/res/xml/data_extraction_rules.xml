<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud-backup en toestel-overdracht nemen het toestel-token niet mee. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rr_device_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rr_device_auth.xml" />
    </device-transfer>
</data-extraction-rules>
