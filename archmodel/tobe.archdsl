    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_scr_overview "OverviewScreen: actieve instellingen + conflicten" {
    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_scr_backup "BackupScreen: backup/restore SAF of iCt Horse" {
    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_scr_settings "SettingsScreen: permissies, opslag, converter, updates, logging" {
    -attr trace = "module:app/src/main/java/ui/screens"
}

