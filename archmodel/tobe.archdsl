// RandomRingtone — architectuurontwerp (to-be) in ArchDSL.
// Bron van het ONTWERP. Platen in generated/ komen hieruit plus de gemeten code
// (asis.facts.json) via /ModelArchDSL update. Niet de platen bewerken, wel dit bestand.
// Inhoud overgenomen uit README.md, CLAUDE.md (F1-F6, T1-T14), FLOW.md v1.6.4 (§1-§13),
// DEPENDENCY_MAP.md, ACTIONS.md (open acties, v2.0.0-plan) en de Kotlin-bronnen op branch main.
// Branches deezer/spotify/youtube zijn historische zijtakken; main (v1.12.2, build 139) is leidend.
//
// Let op granulariteit: de extractor meet modules op mapniveau (data, ui/screens, audio, ...).
// Elementen binnen dezelfde map delen daarom dezelfde trace; het label noemt het Kotlin-bestand.
//
// Conventies: ArchPortal/docs/DSL_CONVENTIES.md
//   -view conceptueel|logisch|fysiek · -attr trace = "<glob op feit-id>" · -attr status = "gepland"|"extern"

set title "RandomRingtone"
set subtitle "Android-app die je ringtone wisselt uit eigen playlists"
set purpose "Bij elke oproep (of op schema) automatisch een willekeurige ringtone uit zelf samengestelde playlists, per kanaal en per contact."

// ================= Conceptueel =================
Driver dr_afwisseling "Afwisseling in ringtone zonder handwerk"
Goal go_random "Willekeurige ringtone per oproep uit eigen playlists"
Goal go_eigen_muziek "Eigen muziek (Spotify/YouTube) als kort ringtone-fragment"
Goal go_geen_verlies "Geen verlies van tracks en playlists"
Requirement rq_kanalen "Vier kanalen: Telefoon, Notificatie, SMS, WhatsApp (F3)"
Requirement rq_modi "Vier modi: Vast, Echt-, Semi- en Quasi-willekeurig"
Requirement rq_schema "Schema: handmatig, elke oproep, 1-12 uur, dagelijks, wekelijks (F4)"
Requirement rq_eenactief "Eén actieve playlist per kanaal + scope (R6)"
Requirement rq_percontact "Per-contact ringtone naast globale ringtone"
Requirement rq_licentie "Alleen gelicenseerde toestellen (device-hash, grace period)"
Constraint cn_permissies "Android-permissies en speciale toegang (WRITE_SETTINGS, notificatie-toegang)"
Constraint cn_standalone "Kernfunctie draait op het toestel; geen eigen server nodig om te wisselen"
Constraint cn_samsung "Samsung OneUI: batterij-optimalisatie en restricted settings"
Constraint cn_converters "Converter-diensten onbetrouwbaar (Cloudflare/JA3, bug #81)"
Principle pr_trackresolver "Eén gedeelde track-resolver voor worker, receiver en service (R8)"

BusinessActor ba_gebruiker "Gebruiker (toestelbezitter)"
BusinessActor ba_beller "Beller / afzender"

BusinessService bs_wisselen "Wisselende ringtone"
BusinessService bs_verzamelen "Ringtones verzamelen en knippen"
BusinessService bs_playlists "Playlists per kanaal en contact"
BusinessService bs_backup "Backup en herstel"
BusinessService bs_beheer "App-beheer (permissies, opslag, updates)"

BusinessProcess bp_schema_wissel "Wisselen op schema (uur/dag/week)"
BusinessProcess bp_bericht_geluid "Eigen geluid bij SMS/WhatsApp"
BusinessProcess bp_permissies "Permissies en speciale toegang verlenen (F5)"
BusinessProcess bp_updaten "App bijwerken via in-app update"
BusinessProcess bp_opstarten "App starten: licentie, migratie, auto-restore"
BusinessProcess bp_spotify_preview "Spotify-preview via Spotify Web API (v2.0.0)" {
    -attr status = "gepland"
    -description "ACTIONS.md hoogste prio: SpotMate vervangen door Client Credentials + preview_url."
}

// Stappen klantreis 1: nummer zoeken en als ringtone knippen
BusinessProcess bp_zoeken "Nummer zoeken in Spotify- of YouTube-tab"
BusinessProcess bp_downloaden "MP3 downloaden via converter"
BusinessProcess bp_editor_openen "Openen in de editor (waveform)"
BusinessProcess bp_knippen "Fragment kiezen, fade instellen, voorbeluisteren"
BusinessProcess bp_opslaan "Opslaan in bibliotheek + playlist (optioneel als ringtone)"

// Stappen klantreis 2: playlist maken en koppelen
BusinessProcess bp_pl_aanmaken "Playlist aanmaken: kanaal, modus, schema"
BusinessProcess bp_contact_kiezen "Scope kiezen: globaal of contact"
BusinessProcess bp_tracks_toevoegen "Tracks uit bibliotheek toevoegen"
BusinessProcess bp_activeren "Playlist activeren (conflicten oplossen)"
BusinessProcess bp_overzicht "Actieve instellingen controleren in Overzicht"

// Stappen klantreis 3: inkomende oproep, daarna willekeurige ringtone
BusinessProcess bp_oproep "Oproep komt binnen, beller wordt vastgelegd"
BusinessProcess bp_gesprek_einde "Gesprek eindigt (telefoon weer IDLE)"
BusinessProcess bp_track_kiezen "Volgende track kiezen volgens modus"
BusinessProcess bp_ringtone_zetten "Ringtone vervangen (globaal of per contact)"
BusinessProcess bp_volgende_oproep "Volgende oproep klinkt met nieuwe ringtone"

// Stappen klantreis 4: backup maken en terugzetten
BusinessProcess bp_bk_provider "Backupbestemming kiezen (cloudmap of iCt Horse)"
BusinessProcess bp_bk_selectie "Selectie kiezen (tracks, playlists)"
BusinessProcess bp_bk_maken "Backup maken"
BusinessProcess bp_bk_preview "Backup-inhoud bekijken"
BusinessProcess bp_bk_herstellen "Herstellen (vervangt huidige data)"

// Stappen klantreis 5: bericht met eigen geluid
BusinessProcess bp_bericht_binnen "SMS- of WhatsApp-bericht komt binnen"
BusinessProcess bp_bericht_match "Playlist zoeken: eerst contact, dan globaal"

