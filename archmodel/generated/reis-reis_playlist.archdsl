// GEGENEREERD door ModelArchDSL — niet met de hand bewerken.
// Bron: archmodel/tobe.archdsl (ontwerp) + archmodel/asis.facts.json (code).
set language archimate
set title "RandomRingtone — Klantreis: playlist maken en koppelen"
set subtitle "Klantreis (stappen genummerd, afspeelbaar in het portaal)"
set purpose "Playlist met kanaal, modus en schema maken, aan een contact of globaal koppelen, tracks toevoegen, activeren en in Overzicht nakijken."
show legend true
switch badges on
set current state "As-is (code)"
set target state "To-be (ontwerp)"

Group laag_business "Business" {
    -width 1220
    -height 310
}
BusinessActor ba_gebruiker "Gebruiker (toestelbezitter)" in laag_business {
    -attr status = "ontwerp"
}
BusinessProcess bp_pl_aanmaken "Playlist aanmaken: kanaal, modus, schema" in laag_business {
    -step 1
    -attr status = "ontwerp"
}
BusinessProcess bp_contact_kiezen "Scope kiezen: globaal of contact" in laag_business {
    -step 2
    -attr status = "ontwerp"
}
BusinessProcess bp_tracks_toevoegen "Tracks uit bibliotheek toevoegen" in laag_business {
    -step 3
    -attr status = "ontwerp"
}
BusinessProcess bp_activeren "Playlist activeren (conflicten oplossen)" in laag_business {
    -step 4
    -attr status = "ontwerp"
}
BusinessProcess bp_overzicht "Actieve instellingen controleren in Overzicht" in laag_business {
    -step 5
    -attr status = "ontwerp"
}
BusinessService bs_playlists "Playlists per kanaal en contact" in laag_business {
    -attr status = "ontwerp"
}

Group laag_application "Applicatie" {
    -width 1220
    -height 310
}
DataObject do_playlists "playlists (Room: kanaal, modus, schema, contact, actief)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "table:playlists"
}
ApplicationComponent ac_scr_playlists "PlaylistManagerScreen: playlists, triggers, schema" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_contacts "ContactsRepository: contacten + CUSTOM_RINGTONE" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
}
Artifact pm_contacts "Permissies READ_/WRITE_CONTACTS" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "permission:READ_CONTACTS, permission:WRITE_CONTACTS"
}
DataObject do_playlist_tracks "playlist_tracks (Room-koppeltabel, CASCADE)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "table:playlist_tracks"
    -description "Koppeltabel playlist ↔ track in RingtoneDb.kt (meerregelige @Entity, sinds ArchPortal AP-004 herkend)."
}
ApplicationComponent ac_resolver "TrackResolver: modus → track → bestand (R8)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_worker "RingtoneWorker: periodiek uur/dag/week (WorkManager)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/worker"
}
ApplicationComponent ac_conflict "ConflictResolver: één actief per kanaal + scope (R1/R6)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_scr_overview "OverviewScreen: actieve instellingen + conflicten" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/ui/screens"
}

// Posities (deterministische raster-layout per ArchiMate-laag)
pos laag_business 40, 40
pos ba_gebruiker 60, 90
pos bp_pl_aanmaken 260, 90
pos bp_contact_kiezen 460, 90
pos bp_tracks_toevoegen 660, 90
pos bp_activeren 860, 90
pos bp_overzicht 1060, 90
pos bs_playlists 60, 220
pos laag_application 40, 390
pos do_playlists 60, 440
pos ac_scr_playlists 260, 440
pos ac_contacts 460, 440
pos pm_contacts 660, 440
pos do_playlist_tracks 860, 440
pos ac_resolver 1060, 440
pos ac_worker 60, 570
pos ac_conflict 260, 570
pos ac_scr_overview 460, 570

// Relaties — Dragon1-compatibel: werkwoordvorm, of ongetypeerd waar Dragon1 het type afleidt
ba_gebruiker associates bs_playlists "gebruikt"
bp_activeren realizes bs_playlists
ac_scr_playlists serves bp_pl_aanmaken
do_playlists serves bp_pl_aanmaken
ac_contacts serves bp_contact_kiezen
pm_contacts serves bp_contact_kiezen
ac_scr_playlists serves bp_tracks_toevoegen
do_playlist_tracks serves bp_tracks_toevoegen
ac_conflict serves bp_activeren
ac_resolver serves bp_activeren "past oproep-playlist direct toe"
ac_worker serves bp_activeren "scheduleAll"
ac_scr_overview serves bp_overzicht
ac_conflict serves bp_overzicht
ac_contacts serves ac_scr_playlists
ac_conflict serves ac_scr_playlists
ac_conflict serves ac_scr_overview
ac_resolver serves ac_worker
ac_resolver accesses do_playlists "leest/werkt bij"
ac_resolver accesses do_playlist_tracks "leest"
ac_conflict accesses do_playlists "deactiveert"
ac_scr_playlists accesses do_playlists "schrijft"
ac_scr_playlists accesses do_playlist_tracks "schrijft"
do_playlists composes do_playlist_tracks "CASCADE"
pm_contacts serves ac_contacts
bp_pl_aanmaken -> bp_contact_kiezen
bp_contact_kiezen -> bp_tracks_toevoegen
bp_tracks_toevoegen -> bp_activeren
bp_activeren -> bp_overzicht
ba_gebruiker -> bp_pl_aanmaken "start"
