ac_scr_playlists -> do_playlist_tracks : access "schrijft"
ac_storage -> do_settings : access "leest/schrijft"
ac_storage -> do_audio : access "beheert"
ac_ringtone -> do_audio : access "MediaStore-registratie"
ac_backupmgr -> do_autobackup : access "schrijft/leest"
ac_backupmgr -> do_backupset : access "schrijft/leest"
ac_icthorse_client -> do_backupset : access "upload/download"
ac_trackid -> do_saved_tracks : access "hernummert"
ac_trackid -> do_playlist_tracks : access "remapt"
do_saved_tracks -> do_playlist_tracks : association "trackId"
do_playlists -> do_playlist_tracks : composition "CASCADE"

// ================= Relaties — fysiek =================
dv_toestel -> ar_apk : assignment "installeert"
ar_apk -> ac_main : realization
ss_compose -> ar_apk : aggregation
ss_room -> ar_apk : aggregation
ss_workmanager -> ar_apk : aggregation
ss_net -> ar_apk : aggregation
ss_datastore -> ar_apk : aggregation
ss_saf -> ar_apk : aggregation
dv_toestel -> ss_android : composition
ss_compose -> ac_main : serving
ss_room -> do_saved_tracks : serving
ss_room -> do_playlists : serving
ss_room -> do_playlist_tracks : serving
ss_workmanager -> ac_worker : serving
ss_datastore -> do_settings : serving
ss_saf -> do_backupset : serving
ss_net -> ac_logger : serving
ss_android -> ac_ringtone : serving "RingtoneManager/MediaStore"
ss_android -> ac_contacts : serving "ContactsContract"
ss_android -> ac_receiver : serving "PHONE_STATE-broadcast"
ss_android -> ac_notifsvc : serving "NotificationListener"
ti_fileprovider -> ac_update : serving
pm_install -> ac_update : serving
pm_boot -> ac_worker : serving "na herstart"
pm_media -> ac_scr_library : serving "scan"
pm_internet -> ss_net : serving
pm_notif -> ac_wissel_melding : serving
pm_settings -> ac_ringtone : serving
pm_contacts -> ac_contacts : serving
pm_call -> ac_receiver : serving
pm_listener -> ac_notifsvc : serving

nd_spotify -> ac_scr_spotify : serving "WebView"
nd_converters -> ac_scr_spotify : serving "WebView-converter"
nd_spotmate -> ac_spotmate : serving
nd_spotify_api -> ac_spotify_webapi : serving
nd_youtube -> ac_scr_youtube : serving "WebView"
nd_y2mate -> ac_y2mate : serving
nd_deezer -> ac_ringtone : serving "previewUrl"
nd_deezer -> ac_deezer : serving
nd_icthorse -> ac_license : serving "lics/{hash}.json"
nd_icthorse -> ac_icthorse_client : serving "backup_api.php"
nd_icthorse -> ac_update : serving "RandomRing/Apk"
nd_cloud -> ss_saf : serving
ac_logger -> nd_logger : flow "POST /rrlog/log"

// ================= Klantreizen =================
Viewpoint reis_knippen "Klantreis: nummer zoeken en als ringtone knippen" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_zoeken bp_downloaden bp_editor_openen bp_knippen bp_opslaan"
    -description "Via Spotify- of YouTube-tab een nummer vinden, MP3 laten converteren, in de editor een fragment met fade knippen en opslaan."
}
Viewpoint reis_playlist "Klantreis: playlist maken en koppelen" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_pl_aanmaken bp_contact_kiezen bp_tracks_toevoegen bp_activeren bp_overzicht"
    -description "Playlist met kanaal, modus en schema maken, aan een contact of globaal koppelen, tracks toevoegen, activeren en in Overzicht nakijken."
}
Viewpoint reis_oproep "Klantreis: oproep → volgende willekeurige ringtone" {
    -attr journey = "true"
    -attr actor = "ba_beller"
    -attr steps = "bp_oproep bp_gesprek_einde bp_track_kiezen bp_ringtone_zetten bp_volgende_oproep"
    -description "EVERY_CALL: na afloop van een gesprek kiest de app volgens de modus de volgende track en zet die als ringtone voor de volgende oproep."
}
Viewpoint reis_backup "Klantreis: backup maken en terugzetten" {
    -attr journey = "true"
    -attr actor = "ba_gebruiker"
    -attr steps = "bp_bk_provider bp_bk_selectie bp_bk_maken bp_bk_preview bp_bk_herstellen"
    -description "Bestemming en selectie kiezen, backup maken naar cloudmap of iCt Horse, inhoud bekijken en herstellen (destructief)."
}
Viewpoint reis_bericht "Klantreis: bericht met eigen geluid" {
    -attr journey = "true"
    -attr actor = "ba_beller"
    -attr steps = "bp_bericht_binnen bp_bericht_match bp_bericht_geluid"
    -description "NotificationService vangt een SMS- of WhatsApp-melding, zoekt de playlist (contact vóór globaal) en speelt een eigen geluid."
}
