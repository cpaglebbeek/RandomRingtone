// GEGENEREERD door ModelArchDSL — niet met de hand bewerken.
// Bron: archmodel/tobe.archdsl (ontwerp) + archmodel/asis.facts.json (code).
set language archimate
set title "RandomRingtone — Klantreis: nummer zoeken en als ringtone knippen"
set subtitle "Klantreis (stappen genummerd, afspeelbaar in het portaal)"
set purpose "Via Spotify- of YouTube-tab een nummer vinden, MP3 laten converteren, in de editor een fragment met fade knippen en opslaan."
show legend true
switch badges on
set current state "As-is (code)"
set target state "To-be (ontwerp)"

Group laag_business "Business" {
    -width 1220
    -height 310
}
BusinessActor ba_gebruiker "Gebruiker (toestelbezitter)" in laag_business {
    -attr status = "ontwerp"
}
BusinessProcess bp_zoeken "Nummer zoeken in Spotify- of YouTube-tab" in laag_business {
    -step 1
    -attr status = "ontwerp"
}
BusinessProcess bp_downloaden "MP3 downloaden via converter" in laag_business {
    -step 2
    -attr status = "ontwerp"
}
BusinessProcess bp_editor_openen "Openen in de editor (waveform)" in laag_business {
    -step 3
    -attr status = "ontwerp"
}
BusinessProcess bp_knippen "Fragment kiezen, fade instellen, voorbeluisteren" in laag_business {
    -step 4
    -attr status = "ontwerp"
}
BusinessProcess bp_opslaan "Opslaan in bibliotheek + playlist (optioneel als ringtone)" in laag_business {
    -step 5
    -attr status = "ontwerp"
}
BusinessService bs_verzamelen "Ringtones verzamelen en knippen" in laag_business {
    -attr status = "ontwerp"
}

Group laag_application "Applicatie" {
    -width 1220
    -height 310
}
ApplicationComponent ac_scr_spotify "SpotifyScreen: Spotify-WebView, klembord, converter" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_scr_youtube "YouTubeScreen: YouTube-WebView + Y2Mate" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_tags "Metadata-tools (Mp3Marker, Mp3TagReader, Mp3AlbumArt, M4aMetadata)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_spotmate "SpotMateDirectClient (Spotify → MP3)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
    -description "Directe API-route. Bug #81: structureel geblokkeerd door Cloudflare; wordt vervangen in v2.0.0."
}
ApplicationComponent ac_y2mate "Y2MateClient (YouTube → MP3)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_main "MainActivity: 7 tabs + editor, licentieblokkade" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "android:activity:MainActivity, module:app/src/main/java"
}
ApplicationComponent ac_decoder "AudioDecoder: MP3 → PCM-waveform (MediaCodec)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/audio"
}
ApplicationComponent ac_scr_editor "EditorScreen: waveform, trim, fade, opslaan" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/ui/screens"
}
ApplicationComponent ac_trimmer "AudioTrimmer: lossless trim + fade (AAC/M4A)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/audio"
}
ApplicationComponent ac_player "AudioPlayer: selectie voorbeluisteren" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/audio"
}
ApplicationComponent ac_ringtone "Ringtone-engine (RingtoneManager.kt: MediaStore, globaal/contact/notificatie)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:app/src/main/java/data"
}
DataObject do_saved_tracks "saved_tracks (Room)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "table:saved_tracks"
}

Group laag_technology "Technologie" {
    -width 620
    -height 180
}
Node nd_spotify "open.spotify.com (Spotify Web in WebView)" in laag_technology {
    -fill "#f0f9ff"
    -stroke "#0284c7"
    -attr status = "extern"
}
Node nd_converters "Converter-sites (spotifydown e.a., via WebView)" in laag_technology {
    -fill "#f0f9ff"
    -stroke "#0284c7"
    -attr status = "extern"
}
Node nd_youtube "YouTube (www.youtube.com in WebView)" in laag_technology {
    -fill "#f0f9ff"
    -stroke "#0284c7"
    -attr status = "extern"
}

// Posities (deterministische raster-layout per ArchiMate-laag)
pos laag_business 40, 40
pos ba_gebruiker 60, 90
pos bp_zoeken 260, 90
pos bp_downloaden 460, 90
pos bp_editor_openen 660, 90
pos bp_knippen 860, 90
pos bp_opslaan 1060, 90
pos bs_verzamelen 60, 220
pos laag_application 40, 390
pos ac_scr_spotify 60, 440
pos ac_scr_youtube 260, 440
pos ac_tags 460, 440
pos ac_spotmate 660, 440
pos ac_y2mate 860, 440
pos ac_main 1060, 440
pos ac_decoder 60, 570
pos ac_scr_editor 260, 570
pos ac_trimmer 460, 570
pos ac_player 660, 570
pos ac_ringtone 860, 570
pos do_saved_tracks 1060, 570
pos laag_technology 40, 740
pos nd_spotify 60, 790
pos nd_converters 260, 790
pos nd_youtube 460, 790

// Relaties — Dragon1-compatibel: werkwoordvorm, of ongetypeerd waar Dragon1 het type afleidt
ba_gebruiker associates bs_verzamelen "gebruikt"
bp_opslaan realizes bs_verzamelen
ac_scr_spotify serves bp_zoeken
ac_scr_youtube serves bp_zoeken
nd_spotify serves bp_zoeken
nd_youtube serves bp_zoeken
ac_spotmate serves bp_downloaden
ac_y2mate serves bp_downloaden
nd_converters serves bp_downloaden
ac_tags serves bp_downloaden "marker + albumcover"
ac_main serves bp_editor_openen "navigatie"
ac_scr_editor serves bp_editor_openen
ac_decoder serves bp_editor_openen "waveform"
ac_scr_editor serves bp_knippen
ac_trimmer serves bp_knippen
ac_player serves bp_knippen
ac_scr_editor serves bp_opslaan
do_saved_tracks serves bp_opslaan
ac_ringtone serves bp_opslaan "optioneel als hoofdringtone"
ac_main composes ac_scr_spotify
ac_main composes ac_scr_youtube
ac_main composes ac_scr_editor
ac_spotmate serves ac_scr_spotify
ac_y2mate serves ac_scr_youtube
ac_decoder serves ac_scr_editor
ac_trimmer serves ac_scr_editor
ac_player serves ac_scr_editor
ac_tags serves ac_trimmer "metadata behouden"
ac_scr_editor accesses do_saved_tracks "schrijft"
nd_spotify serves ac_scr_spotify "WebView"
nd_converters serves ac_scr_spotify "WebView-converter"
nd_youtube serves ac_scr_youtube "WebView"
bp_zoeken -> bp_downloaden
bp_downloaden -> bp_editor_openen
bp_editor_openen -> bp_knippen
bp_knippen -> bp_opslaan
ba_gebruiker -> bp_zoeken "start"
