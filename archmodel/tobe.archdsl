    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_contacts "ContactsRepository: contacten + CUSTOM_RINGTONE" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_storage "StorageManager: paden, DataStore, bestandsscan, converterlijst" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_backupmgr "BackupManager: SAF-backup, selectie, auto-backup, playlist-export" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_trackid "TrackId-strategie + eenmalige migratie v8 (TrackIdResolver, TrackIdMigration)" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_tags "Metadata-tools (Mp3Marker, Mp3TagReader, Mp3AlbumArt, M4aMetadata)" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_license "LicenseManager: device-hash → licentie" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_update "UpdateManager: in-app APK-updates (T12)" {
    -attr trace = "module:app/src/main/java/data, android:provider:FileProvider"
}
ApplicationComponent ac_logger "RemoteLogger: wachtrij, flush 2 s, heartbeat 30 s" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_spotmate "SpotMateDirectClient (Spotify → MP3)" {
    -attr trace = "module:app/src/main/java/data"
    -description "Directe API-route. Bug #81: structureel geblokkeerd door Cloudflare; wordt vervangen in v2.0.0."
}
ApplicationComponent ac_y2mate "Y2MateClient (YouTube → MP3)" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_icthorse_client "IctHorseBackupClient (backup_api.php)" {
    -attr trace = "module:app/src/main/java/data"
}
ApplicationComponent ac_deezer "DeezerApi-client (T1; in main geen aanroeper meer)" {
    -attr trace = "module:app/src/main/java/data"
    -description "Deezer-tab is uit main verdwenen; Deezer-previews worden nog door de ringtone-engine gedownload via previewUrl."
}

// Gepland (ACTIONS.md / CONFLICTS open / roadmap v0.8.0)
ApplicationComponent ac_spotify_webapi "SpotifyWebApiClient: Client Credentials + preview_url (v2.0.0)" {
    -attr status = "gepland"
    -description "Vervangt SpotMateDirectClient in SpotifyScreen; token-cache ~1 uur; tracks zonder preview_url → WebView-converter."
}
ApplicationComponent ac_okhttp_shared "Gedeelde OkHttpClient (R9)" {
    -attr status = "gepland"
    -description "Nu maakt elke client een eigen OkHttpClient aan (FLOW §13)."
}
ApplicationComponent ac_predownload "Pre-download bij playlist-activering (R10)" {
    -attr status = "gepland"
}
ApplicationComponent ac_y2mate_host "Y2Mate-host dynamisch bepalen (R12)" {
    -attr status = "gepland"
}
ApplicationComponent ac_accu "Uitzondering batterij-optimalisatie aanvragen (roadmap v0.8.0)" {
    -attr status = "gepland"
}
ApplicationComponent ac_wissel_melding "Melding bij ringtone-wissel (roadmap v0.8.0)" {
    -attr status = "gepland"
    -description "POST_NOTIFICATIONS staat al in het manifest maar wordt nog niet gebruikt."
}

